// Cloudflare Workers 部署配置（静态资源 + /api 一体化）
// 部署步骤见 README.md「部署」一节。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "huahuacai",
  "main": "worker/index.js",
  "compatibility_date": "2025-05-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA 路由（react-router）回退到 index.html
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "ROOMS",
      // 本文件是基础模板；部署时不直接使用它——scripts/build-config.mjs 会读取
      // 环境变量 KV_NAMESPACE_ID 生成 wrangler.generated.jsonc 再部署，
      // 所以此处占位符无需修改（Cloudflare Git 构建在「设置 → 构建 → 变量和密钥」注入）
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
